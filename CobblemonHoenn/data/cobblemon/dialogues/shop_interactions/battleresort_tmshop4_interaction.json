            "id": "pickhealbell",
            "speaker": "npc",
            "lines": [
                "8BP) The user makes a soothing bell chime to cure the status conditions of all its fellow party Pokémon and allies."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('BPHave8')",
                        "text": "Buy 1",
                        "value": "buy1",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run givetm healbell @s');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:tmget ambient @s ~ ~ ~ 1 1 1');",
