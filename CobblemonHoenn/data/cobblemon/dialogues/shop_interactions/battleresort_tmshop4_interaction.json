{
    "initializationAction": [
        "q.run_command('execute as ' + q.player.username + ' run function hoenn:data/testformoney');",
        "q.run_command('team join battlepoints ' + q.player.username + '');"
    ],
    "escapeAction": [
        "q.run_command('execute as ' + q.player.username + ' run function hoenn:data/removemoneytags');",
        "q.dialogue.close();"
    ],
    "speakers": {
        "npc": {
            "name": "TM Shopkeeper",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:triathlete",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Welcome, welcome! Would you like the TM for a move in return for some BP?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": "q.dialogue.set_page('buy1');"
                    },
                    {
                        "text": "No Thanks",
                        "value": "nothanks",
                        "action": "q.dialogue.set_page('end');"
                    }
                ]
            }
        },
        {
            "id": "buy1",
            "speaker": "npc",
            "lines": [
                "Which move would you like to purchase?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Heal Bell",
                        "value": "healbell",
                        "action": "q.dialogue.set_page('pickhealbell');"
                    },
