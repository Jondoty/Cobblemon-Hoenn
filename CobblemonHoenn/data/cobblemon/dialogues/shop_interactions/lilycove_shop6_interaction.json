                "identifier": "cobblemon:shopman",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Welcome to Lilycove Department Store!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": "q.dialogue.set_page('buy1');"
                    },
                    {
                        "text": "No Thanks",
                        "value": "nothanks",
                        "action": "q.dialogue.set_page('end');"
                    }
                ]
            }
        },
        {
            "id": "buy1",
            "speaker": "npc",
            "lines": [
                "I have TMs! Are you looking for anything in particular?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Protect TM",
                        "value": "protect",
                        "action": "q.dialogue.set_page('pickprotect');"
                    },
                    {
                        "text": "Safeguard TM",
                        "value": "safeguard",
                        "action": "q.dialogue.set_page('picksafeguard');"
                    },
                    {
                        "text": "Reflect TM",
                        "value": "reflect",
                        "action": "q.dialogue.set_page('pickreflect');"
                    },
                    {
                        "text": "Light Screen TM",
                        "value": "lightscreen",
                        "action": "q.dialogue.set_page('picklightscreen');"
                    },
                    {
                        "text": "No Thanks",
                        "value": "nothanks",
                        "action": "q.dialogue.set_page('end');"
                    }
                ]
            }
        },




        {
            "id": "pickprotect",
            "speaker": "npc",
            "lines": [
                "$5000) This move enables the user to protect itself from all attacks. Its chance of failing rises if it is used in succession."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('MoneyHave5000')",
                        "text": "Buy 1",
                        "value": "buy1",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run givetm protect @s');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:tmget ambient @s ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players remove @s Money 5000');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
