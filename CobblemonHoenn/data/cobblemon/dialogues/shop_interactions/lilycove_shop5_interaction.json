                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('MoneyHave15000')",
                        "text": "Buy 1",
                        "value": "buy1",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run givetm fireblast @s');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:tmget ambient @s ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players remove @s Money 15000');",
