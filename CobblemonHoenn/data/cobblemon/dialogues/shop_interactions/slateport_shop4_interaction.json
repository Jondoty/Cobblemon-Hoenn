            }
        },
        {
            "id": "buyend",
            "speaker": "npc",
            "lines": [
                "Thank you for your patronage!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run function hoenn:data/removemoneytags');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
