{
    "initializationAction": [
        "q.run_command('execute as ' + q.player.username + ' run function hoenn:data/testformoney');"
    ],
    "escapeAction": [
        "q.run_command('execute as ' + q.player.username + ' run function hoenn:data/removemoneytags');",
        "q.dialogue.close();"
    ],
    "speakers": {
        "npc": {
            "name": "Traveling TM Shop",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:shopman",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Welcome to the traveling TM shop!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": "q.dialogue.set_page('buy1');"
                    },
                    {
                        "text": "No Thanks",
                        "value": "nothanks",
                        "action": "q.dialogue.set_page('end');"
                    }
                ]
            }
        },
        {
            "id": "buy1",
            "speaker": "npc",
            "lines": [
                "Are you looking for anything in particular?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Hone Claws TM",
                        "value": "honeclaws",
                        "action": "q.dialogue.set_page('pickhoneclaws');"
                    },
                    {
                        "text": "Thunder Wave TM",
                        "value": "thunderwave",
                        "action": "q.dialogue.set_page('pickthunderwave');"
                    },
                    {
                        "text": "Struggle Bug TM",
                        "value": "strugglebug",
                        "action": "q.dialogue.set_page('pickstrugglebug');"
                    },
                    {
                        "text": "Confide TM",
                        "value": "confide",
                        "action": "q.dialogue.set_page('pickconfide');"
                    },
                    {
                        "text": "No Thanks",
                        "value": "nothanks",
                        "action": "q.dialogue.set_page('end');"
                    }
                ]
            }
        },
        {
            "id": "pickhoneclaws",
            "speaker": "npc",
            "lines": [
                "$5000) The user sharpens its claws to boost its Attack stat and accuracy."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('MoneyHave5000')",
                        "text": "Buy 1",
                        "value": "buy1",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run givetm honeclaws @s');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:tmget ambient @s ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players remove @s Money 5000');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickthunderwave",
            "speaker": "npc",
            "lines": [
